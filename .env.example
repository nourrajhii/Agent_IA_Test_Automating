# Copier en ".env" (même dossier que docker-compose.yml) puis ajuster.

# Modèles Ollama (voir app/config.py)
TEXT_MODEL=llama3.2:1b
VISION_MODEL=llava:7b
AGENT_MODEL=llama3.1:8b

# Nombre de Chrome headless / générations LLM en parallèle.
# Baisser si le conteneur backend manque de RAM ou plante.
EXECUTION_CONCURRENCY=3
SCENARIO_GEN_CONCURRENCY=2

# URL que le frontend build utilise pour appeler le backend depuis le
# navigateur de l'utilisateur (pas depuis l'intérieur de Docker).
# Si tu déploies sur un serveur distant, remplace localhost par l'IP/domaine.
VITE_API_URL=http://localhost:8000
